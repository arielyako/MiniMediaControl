<Window x:Class="MiniMediaControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Media Control" Width="380" Height="150"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing"
        MouseWheel="Window_MouseWheel">

    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="17" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ===== Seeker colors: edit these ===== -->
        <SolidColorBrush x:Key="SeekFillBrush"  Color="#1DB954"/>   <!-- played part -->
        <SolidColorBrush x:Key="SeekTrackBrush" Color="#33FFFFFF"/> <!-- remaining part -->
        <SolidColorBrush x:Key="SeekDotBrush"   Color="White"/>     <!-- the dot -->

        <!-- Round dot -->
        <Style x:Key="SeekThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <!-- Canvas = the thumb's real size (must match Width/Height on the Thumb) -->
                        <Canvas Width="12" Height="20">

                            <!-- Glow: free to overflow. Left/Top = -(glow size - thumb size) / 2 -->
                            <Grid x:Name="glow" Width="28" Height="28"
                                Canvas.Left="-8" Canvas.Top="-4"
                                RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">

                                <Ellipse x:Name="halo" Fill="{StaticResource SeekFillBrush}" Opacity="0.55">
                                    <Ellipse.OpacityMask>
                                        <RadialGradientBrush RadiusX="0.5" RadiusY="0.5">
                                            <GradientStop Color="#FF000000" Offset="0.0"/>
                                            <GradientStop Color="#80000000" Offset="0.45"/>
                                            <GradientStop Color="#00000000" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Ellipse.OpacityMask>
                                </Ellipse>

                                <Ellipse x:Name="core" Width="10" Height="10" Fill="White" Opacity="0.85">
                                    <Ellipse.OpacityMask>
                                        <RadialGradientBrush>
                                            <GradientStop Color="#FF000000" Offset="0.2"/>
                                            <GradientStop Color="#00000000" Offset="1.0"/>
                                        </RadialGradientBrush>
                                    </Ellipse.OpacityMask>
                                </Ellipse>
                            </Grid>

                            <!-- Invisible hit area so the thumb is still easy to grab -->
                            <Rectangle Width="12" Height="20" Fill="Transparent"/>
                        </Canvas>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="halo" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="glow" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Played part of the bar -->
        <Style x:Key="SeekFillButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource SeekFillBrush}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Remaining part of the bar -->
        <Style x:Key="SeekTrackButton" TargetType="RepeatButton" >
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The slider itself -->
        <Style x:Key="SeekSliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                                    Background="{StaticResource SeekTrackBrush}"/>
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SeekFillButton}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SeekTrackButton}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="dot" Style="{StaticResource SeekThumb}" Opacity="0" Width="12" Height="20"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger SourceName="dot" Property="IsDragging" Value="True">
                                <Setter TargetName="dot" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <!-- Icon shapes on a 24x24 canvas -->
    <Geometry x:Key="IconPlay">M7,5 L19,12 L7,19 Z</Geometry>
    <Geometry x:Key="IconPause">M8,6 L8,18 M16,6 L16,18</Geometry>
    <Geometry x:Key="IconNext">M6,6 L16,12 L6,18 Z M19,6 L19,18</Geometry>
    <Geometry x:Key="IconPrev">M18,6 L8,12 L18,18 Z M5,6 L5,18</Geometry>

    <!-- Fat rounded look: filled shape + thick stroke with round joins and caps -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="3"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
    </Style>
    </Window.Resources>

    <Border Margin="6" CornerRadius="16" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop x:Name="GradTop"    Color="#F0202026" Offset="0"/>
                <GradientStop x:Name="GradBottom" Color="#F0202026" Offset="0.85"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Reset position" Click="ResetPosition_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="22"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Grip: drag here to move the window -->
            <Grid Grid.Row="0" Background="Transparent" Cursor="SizeAll"
                  MouseLeftButtonDown="Grip_MouseDown" MouseLeftButtonUp="Grip_MouseUp">
                <TextBlock x:Name="SourceText" Margin="14,4,0,0" Foreground="#99FFFFFF" FontSize="11"
                           HorizontalAlignment="Left"/>
                <Border Width="36" Height="4" CornerRadius="2" Background="#44FFFFFF"
                        VerticalAlignment="Top" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="PrevSourceBtn" Style="{StaticResource IconBtn}" Width="24" Height="20" FontSize="10"
                            Content="&#xE76B;" Click="PrevSource_Click"/>
                    <Button x:Name="NextSourceBtn" Style="{StaticResource IconBtn}" Width="24" Height="20" FontSize="10"
                            Content="&#xE76C;" Click="NextSource_Click"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource IconBtn}" Width="24" Height="20" FontSize="10"
                            Content="&#xE711;" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Card that slides when switching source -->
            <Grid Grid.Row="1" x:Name="Card" Background="Transparent" Margin="12,0,12,10"
                  PreviewMouseLeftButtonDown="Card_PreviewDown" PreviewMouseLeftButtonUp="Card_PreviewUp">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="Shift"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Album art with placeholder -->
                <Border x:Name="ArtBorder" Grid.Column="0" Width="92" Height="92" CornerRadius="10" Background="#33363F"
                        VerticalAlignment="Center">
                    <Grid>
                        <TextBlock Text="&#x266A;" FontSize="34" Foreground="#66FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                   
                        <Border CornerRadius="10">
                            
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleText" Grid.Row="0" Foreground="White" FontSize="14"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="Nothing playing"/>
                    <TextBlock x:Name="ArtistText" Grid.Row="1" Foreground="#AAFFFFFF" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>

                    <Slider x:Name="SeekSlider"
                        Panel.ZIndex="10"
                        Style="{StaticResource SeekSliderStyle}"
                        Grid.Row="2"
                        Minimum="0"
                        Maximum="1"
                        Height="20"
                        VerticalAlignment="Center" IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="Seek_Down" PreviewMouseLeftButtonUp="Seek_Up"/>
                    
                    <StackPanel x:Name="ControlsPanel" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Click="Prev_Click">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPrev}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button x:Name="PlayBtn" Style="{StaticResource IconBtn}" Click="PlayPause_Click">
                            <Viewbox Width="22" Height="22">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="PlayIcon" Style="{StaticResource IconPath}" Data="{StaticResource IconPlay}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource IconBtn}" Click="Next_Click">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Style="{StaticResource IconPath}" Data="{StaticResource IconNext}"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <TextBlock x:Name="TimeText" Visibility="Collapsed" Foreground="#88FFFFFF" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
